# Optional: eigener Gemini API-Schlüssel, niemals im Frontend eintragen
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Offizielle Wirtschaftsdaten höchstens alle sechs Stunden neu laden:
HARD_DATA_CACHE_SECONDS=21600
# Je Feed werden bis zu 30 aktuelle Einträge gelesen; bis zu 30 lokal priorisierte Artikel gehen in den gemeinsamen KI-Aufruf:
NEWS_FEED_ITEMS=30
NEWS_AI_CANDIDATES=30
# Feste Blockgewichte, zusammen 100; Standard 50/25/25:
# DECISION_WEIGHTS_JSON={"technical":50,"hard_data":25,"normal_news":25}
# Feste Einzelgewichte im Makroblock, zusammen 100:
# Zinsen 30, Inflation 30, Arbeitsmarkt/Löhne 25, Wachstum 15.
# MACRO_WEIGHTS_JSON={"DFEDTARL":9,"DFEDTARU":9,"DGS10":12,"CUUR0000SA0":12,"CUUR0000SA0L1E":8,"PCEPILFE":10,"CES0000000001":14,"LNS14000000":5,"LNS11300000":1,"CES0500000003":5,"GDPC1":10,"RSAFS":5}
# Bei anderen lokalen Frontend-Ports ergänzen (durch Komma getrennt):
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Optionaler anderer Datenbankpfad:
# TRADING_DB_PATH=C:/path/to/trading_platform.db

# Options-Greeks: nur bei Quant-Knopfdruck/Marktscan im Gemini-Modus.
# auto: Alpaca bei vorhandenen Schlüsseln, sonst Yahoo (nur Referenzwerte).
# OPTIONS_PROVIDER=auto
# Optional: OPRA benötigt einen passenden Alpaca-Datenzugang. Kein automatischer
# Wechsel auf indicative bei fehlender Berechtigung. indicative ist kein Echtzeitfeed.
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# OPTIONS_ALPACA_FEED=opra
# Modellzins als Dezimalzahl, z.B. 0.04 = 4%; selbst aktuell halten.
# Ohne Vorgabe: vorhandene Fed-Zielband-Mitte (max. 10 Tage alt) als Modellproxy.
# OPTIONS_RISK_FREE_RATE=
# Kontinuierliche Modell-Dividendenrendite als Dezimalzahl; sonst explizite q=0-Annahme.
# OPTIONS_DIVIDEND_YIELD=0
